NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Finnhub (real-time market data) ─────────────────────────────────────────
# Sign up free at https://finnhub.io → Dashboard → API Keys
# Free tier: 60 calls/min, real-time US quotes, no location restrictions
FINNHUB_API_KEY=

# ── Broker / Trading ─────────────────────────────────────────────────────────
# Leave BROKER_PROVIDER=paper to simulate trades without a real broker account.
# Set to interactive_brokers if you have an IBKR account (works in Canada).
BROKER_PROVIDER=paper          # paper | interactive_brokers
TEST_MODE=true                 # true = paper trading, false = live (real money!)
AUTO_TRADE=false               # auto-execute signals — leave false until ready
MAX_POSITION_SIZE=2000         # max $ per trade
MAX_RISK_PER_TRADE=1           # max % of account per trade

# ── Email Notifications (optional) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@morningedge.io
EMAIL_TO=your.email@example.com
EMAIL_REPLY_TO=support@morningedge.io

# ── Security (optional) ───────────────────────────────────────────────────────
CRON_SECRET=your_secret_cron_token
ADMIN_TOKEN=your_admin_token

# ── Database — Supabase (optional) ───────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
